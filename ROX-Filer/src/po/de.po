msgid "Appearance"
msgstr "Aussehen"

#: tips:168 Options.xml.h:162
msgid "Toolbar style:"
msgstr "Werkzeugleistenstil:"

#: tips:169 Options.xml.h:163
msgid "No toolbar"
msgstr "Keine Werkzeugleiste"

