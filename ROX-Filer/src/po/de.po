#: Options.xml.h
msgid "Drives"
msgstr "Laufwerke"

#: Options.xml.h
msgid "Automatic mounting"
msgstr "Automatisches Einhängen"

#: Options.xml.h
msgid "Mount local drives automatically at startup"
msgstr "Lokale Laufwerke beim Start automatisch einhängen"

#: Options.xml.h
msgid "Automatically mount available local disk partitions when Rox-Filer2 starts. Network shares, phones, cameras, mounted images, optical media, encrypted containers and system partitions are not mounted automatically."
msgstr "Verfügbare lokale Datenträgerpartitionen beim Start von Rox-Filer2 automatisch einhängen. Netzwerkfreigaben, Telefone, Kameras, eingehängte Abbilder, optische Medien, verschlüsselte Container und Systempartitionen werden nicht automatisch eingehängt."

#: Options.xml.h
msgid "Include removable drives"
msgstr "Wechseldatenträger einbeziehen"

#: Options.xml.h
msgid "Also include removable USB, SD and similar storage devices when automatic startup mounting is enabled."
msgstr "Bezieht auch wechselbare USB-, SD- und ähnliche Speichergeräte ein, wenn das automatische Einhängen beim Start aktiviert ist."
