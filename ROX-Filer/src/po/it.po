msgstr "Icone piccole"

#: tips:194 Options.xml.h:188
msgid "Large icons"
msgstr "Icone grandi"

#: tips:195 Options.xml.h:189
msgid "Same as the current window"
msgstr "Come la finestra corrente"

#: tips:196 Options.xml.h:190
msgid "Same as the default view"
msgstr "Come la vista predefinita"

#: tips:197 Options.xml.h:191
msgid "Open a terminal with the grave (`) key"
msgstr "Apri un terminale con il tasto accento grave (`)"

#: tips:198 Options.xml.h:192
msgid "Classic panels"
msgstr "Pannelli classici"

#: tips:199 Options.xml.h:193
msgid "Override window-manager control of classic panels"
msgstr "Ignora il controllo del gestore di finestre sui pannelli classici"

#: tips:200 Options.xml.h:194
msgid "Treat classic panels as docks"
msgstr "Tratta i pannelli classici come dock"

#: tips:201 Options.xml.h:195
msgid "Keep classic panels above other windows"
