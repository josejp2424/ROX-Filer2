"Clic sinistro: mostra/nasconde i file nascosti\n"
"Clic destro: mostra/nasconde le miniature"

msgid ""
"Left: New Directory\n"
"Center: New Blank file\n"
"Right: Menu"
msgstr ""
"Left: New Directory\n"
"Center: New Blank file\n"
"Right: Menu"

