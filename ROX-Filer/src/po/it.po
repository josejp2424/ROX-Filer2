#, c-format, python-format
msgid ""
"Usage: rox [OPTION]... [FILE]...\n"
"Open each directory or file listed, or the current working\n"
"directory if no arguments are given.\n"
"\n"
"ROX Desktop:\n"
"      --desktop\tstart ROX Desktop with wallpaper, Desktop files and drives\n"
"\n"
"File manager:\n"
"  -c, --client-id=ID\tused for session management\n"
"  -d, --dir=DIR\t\topen DIR as directory (not application)\n"
"  -D, --close=DIR\tclose DIR and its subdirectories\n"
"  -h, --help\t\tdisplay this help and exit\n"
"  -m, --mime-type=FILE\tprint MIME type of FILE and exit\n"
"  -n, --new\t\tstart a separate filer instance\n"
"  -R, --RPC\t\tinvoke method call read from stdin\n"
"  -s, --show=FILE\topen a directory showing FILE\n"
"  -u, --user\t\tshow user name in each window\n"
"  -U, --url=URL\t\topen file or directory in URI form\n"
"  -v, --version\t\tdisplay version information and exit\n"
"  -x, --examine=FILE\tFILE has changed - re-examine it\n"
"\n"
"Legacy ROX desktop compatibility:\n"
"  -b, --border=PANEL\topen PANEL as a border panel\n"
"  -B, --bottom=PANEL\topen PANEL as a bottom-edge panel\n"
"  -l, --left=PANEL\topen PANEL as a left-edge panel\n"
"  -p, --pinboard=PIN\tuse the classic ROX pinboard\n"
"  -r, --right=PANEL\topen PANEL as a right-edge panel\n"
"  -S, --rox-session\tuse the classic panel and pinboard session\n"
"  -t, --top=PANEL\topen PANEL as a top-edge panel\n"
"\n"
"Report bugs to %s.\n"
"Project: https://github.com/josejp2424/Rox-Filer2-gtk3\n"
msgstr ""
"Uso: rox [OPZIONE]... [FILE]...\n"
"Apre ogni directory o file indicato, oppure la directory di lavoro\n"
"corrente se non viene fornito alcun argomento.\n"
"\n"
"Desktop ROX:\n"
"      --desktop\tavvia il Desktop ROX con sfondo, file del Desktop e unità\n"
"\n"
"Gestore file:\n"
"  -c, --client-id=ID\tusato per la gestione della sessione\n"
"  -d, --dir=DIR\t\tapre DIR come directory (non come applicazione)\n"
"  -D, --close=DIR\tchiude DIR e le sue sottodirectory\n"
"  -h, --help\t\tmostra questo aiuto ed esce\n"
"  -m, --mime-type=FILE\tstampa il tipo MIME di FILE ed esce\n"
"  -n, --new\t\tavvia un'istanza separata del gestore file\n"
"  -R, --RPC\t\tesegue la chiamata di metodo letta da stdin\n"
"  -s, --show=FILE\tapre una directory mostrando FILE\n"
"  -u, --user\t\tmostra il nome utente in ogni finestra\n"
"  -U, --url=URL\t\tapre file o directory in formato URI\n"
"  -v, --version\t\tmostra le informazioni sulla versione ed esce\n"
"  -x, --examine=FILE\tFILE è cambiato - riesaminalo\n"
"\n"
"Compatibilità con il desktop ROX classico:\n"
"  -b, --border=PANEL\tapre PANEL come pannello di bordo\n"
"  -B, --bottom=PANEL\tapre PANEL sul bordo inferiore\n"
"  -l, --left=PANEL\tapre PANEL sul bordo sinistro\n"
"  -p, --pinboard=PIN\tusa il pinboard ROX classico\n"
"  -r, --right=PANEL\tapre PANEL sul bordo destro\n"
"  -S, --rox-session\tusa la sessione classica pannello/pinboard\n"
"  -t, --top=PANEL\tapre PANEL sul bordo superiore\n"
"\n"
"Segnala i bug a %s.\n"
"Progetto: https://github.com/josejp2424/Rox-Filer2-gtk3\n"

# ROX Desktop r39 - XDG default applications
#, python-format
