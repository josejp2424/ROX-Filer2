msgstr "Avvia le operazioni di collegamento senza una conferma aggiuntiva"

#: Options.xml.h:138
msgid "Confirm before moving files to Trash"
msgstr "Conferma prima di spostare i file nel Cestino"

#: Options.xml.h:139
msgid "Confirm before permanently deleting files"
msgstr "Conferma prima di eliminare definitivamente i file"

#: tips:144 Options.xml.h:138
msgid "Start permanent deletion without an extra confirmation"
msgstr "Avvia l’eliminazione permanente senza una conferma aggiuntiva"

#: tips:145 Options.xml.h:139
msgid "Start mount operations without an extra confirmation"
msgstr "Avvia le operazioni di montaggio senza una conferma aggiuntiva"

#: tips:146 Options.xml.h:140
msgid "Default action-window settings"
msgstr "Impostazioni predefinite della finestra delle operazioni"

#: tips:147 Options.xml.h:141
msgid "Do not ask again for non-writable items"
msgstr "Non chiedere di nuovo per gli elementi non scrivibili"

#: tips:148 Options.xml.h:142
msgid "Use brief operation messages"
msgstr "Usa messaggi brevi per le operazioni"

#: tips:149 Options.xml.h:143
msgid "Apply operations recursively"
msgstr "Applica le operazioni ricorsivamente"

#: tips:150 Options.xml.h:144
msgid "Merge directories by default"
msgstr "Unisci le cartelle per impostazione predefinita"

#: tips:151 Options.xml.h:145
msgid "Replace when the source is newer"
msgstr "Sostituisci quando la sorgente è più recente"

#: tips:152 Options.xml.h:146
msgid "Ignore older source files"
msgstr "Ignora i file sorgente più vecchi"

#: tips:153 Options.xml.h:147
msgid "Drag and drop"
msgstr "Trascinamento"

#: tips:154 Options.xml.h:148
msgid "Allow dropping onto directory and application icons"
msgstr "Consenti il rilascio sulle icone di cartelle e applicazioni"

#: tips:155 Options.xml.h:149
msgid "Open directories after hovering during a drag"
msgstr "Apri le cartelle dopo il passaggio del mouse durante un trascinamento"

