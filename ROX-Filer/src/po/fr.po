msgid "The filesystem containing '%s' does not support the standard Trash.\n"
msgstr ""
"Le système de fichiers contenant « %s » ne prend pas en charge la corbeille "
"standard.\n"

#. Agregado por josejp2424 (2026): papelera estándar y borrado por lotes.
#, python-format
msgid "Unable to move '%s' to the Trash: %s\n"
msgstr "Impossible de mettre « %s » à la corbeille : %s\n"

msgid "Unable to read the device"
msgstr "Impossible de lire le périphérique"

msgid "Open Desktop Folder"
msgstr "Ouvrir le dossier Bureau"

#, c-format, python-format
msgid ""
"Usage: rox [OPTION]... [FILE]...\n"
"Open each directory or file listed, or the current working\n"
"directory if no arguments are given.\n"
"\n"
"ROX Desktop:\n"
"      --desktop\tstart ROX Desktop with wallpaper, Desktop files and drives\n"
"\n"
"File manager:\n"
"  -c, --client-id=ID\tused for session management\n"
"  -d, --dir=DIR\t\topen DIR as directory (not application)\n"
"  -D, --close=DIR\tclose DIR and its subdirectories\n"
"  -h, --help\t\tdisplay this help and exit\n"
"  -m, --mime-type=FILE\tprint MIME type of FILE and exit\n"
"  -n, --new\t\tstart a separate filer instance\n"
"  -R, --RPC\t\tinvoke method call read from stdin\n"
"  -s, --show=FILE\topen a directory showing FILE\n"
"  -u, --user\t\tshow user name in each window\n"
"  -U, --url=URL\t\topen file or directory in URI form\n"
"  -v, --version\t\tdisplay version information and exit\n"
"  -x, --examine=FILE\tFILE has changed - re-examine it\n"
"\n"
"Legacy ROX desktop compatibility:\n"
"  -b, --border=PANEL\topen PANEL as a border panel\n"
"  -B, --bottom=PANEL\topen PANEL as a bottom-edge panel\n"
"  -l, --left=PANEL\topen PANEL as a left-edge panel\n"
"  -p, --pinboard=PIN\tuse the classic ROX pinboard\n"
"  -r, --right=PANEL\topen PANEL as a right-edge panel\n"
"  -S, --rox-session\tuse the classic panel and pinboard session\n"
"  -t, --top=PANEL\topen PANEL as a top-edge panel\n"
"\n"
"Report bugs to %s.\n"
"Project: https://github.com/josejp2424/Rox-Filer2-gtk3\n"
msgstr ""
"Utilisation : rox [OPTION]... [FICHIER]...\n"
"Ouvre chaque répertoire ou fichier indiqué, ou le répertoire de travail\n"
"courant si aucun argument n'est fourni.\n"
"\n"
"Bureau ROX :\n"
"      --desktop\tdémarre le bureau ROX avec fond d'écran, fichiers du Bureau "
"et lecteurs\n"
"\n"
"Gestionnaire de fichiers :\n"
"  -c, --client-id=ID\tutilisé pour la gestion de session\n"
"  -d, --dir=RÉP\t\touvre RÉP comme répertoire (pas comme application)\n"
"  -D, --close=RÉP\tferme RÉP et ses sous-répertoires\n"
"  -h, --help\t\taffiche cette aide et quitte\n"
"  -m, --mime-type=FICHIER\taffiche le type MIME de FICHIER et quitte\n"
"  -n, --new\t\tdémarre une instance séparée du gestionnaire\n"
"  -R, --RPC\t\texécute l'appel de méthode lu depuis stdin\n"
"  -s, --show=FICHIER\touvre un répertoire en affichant FICHIER\n"
"  -u, --user\t\taffiche le nom d'utilisateur dans chaque fenêtre\n"
"  -U, --url=URL\t\touvre un fichier ou répertoire sous forme d'URI\n"
"  -v, --version\t\taffiche les informations de version et quitte\n"
"  -x, --examine=FICHIER\tFICHIER a changé - le réexaminer\n"
"\n"
"Compatibilité avec le bureau ROX classique :\n"
"  -b, --border=PANEL\touvre PANEL comme panneau de bordure\n"
"  -B, --bottom=PANEL\touvre PANEL sur le bord inférieur\n"
"  -l, --left=PANEL\touvre PANEL sur le bord gauche\n"
"  -p, --pinboard=PIN\tutilise le pinboard ROX classique\n"
"  -r, --right=PANEL\touvre PANEL sur le bord droit\n"
"  -S, --rox-session\tutilise la session classique panneau/pinboard\n"
"  -t, --top=PANEL\touvre PANEL sur le bord supérieur\n"
"\n"
"Signalez les bogues à %s.\n"
"Projet : https://github.com/josejp2424/Rox-Filer2-gtk3\n"

# ROX Desktop r39 - XDG default applications
