#: menu.c
msgid "Select a single folder to open a terminal there."
msgstr "Sélectionnez un seul dossier pour y ouvrir un terminal."

#: menu.c
msgid "Select a single executable file or script to run in a terminal."
msgstr "Sélectionnez un seul fichier exécutable ou script à lancer dans un terminal."

#: menu.c
