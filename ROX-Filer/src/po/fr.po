msgid ""
"'Skipped existing destination '%s'\n"
msgstr ""
"'Destination existante « %s » ignorée\n"

#. Agregado por josejp2424: motor rsync y política de conflictos.
msgid ""
"!Cannot replace non-empty directory '%s': %s\n"
msgstr ""
