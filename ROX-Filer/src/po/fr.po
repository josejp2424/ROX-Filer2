msgstr "Définir en tant que défaut pour tous `%s/<quelconque>'"

msgid "Use this application for all files with this MIME type."
msgstr "Utiliser cette application pour tous les fichiers de ce type MIME."

#, c-format, python-format
msgid "Only for the type `%s' (%s/%s)"
msgstr "Pour le type `%s' uniquement (%s/%s)"

