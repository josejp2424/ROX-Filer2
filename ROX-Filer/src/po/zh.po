msgstr "默认包含子目录"

#: tips:124 Options.xml.h:118
msgid "Include hidden items by default"
msgstr "默认包含隐藏项目"

#: tips:125 Options.xml.h:119
msgid "Follow symbolic links by default"
msgstr "默认跟随符号链接"

#: tips:126 Options.xml.h:120
msgid "Stay on the selected filesystem by default"
msgstr "默认停留在所选文件系统中"

#: tips:127 Options.xml.h:121
msgid "Maximum file size for content search:"
msgstr "内容搜索的最大文件大小："

#: tips:128 Options.xml.h:122
msgid "MB"
msgstr "MB"

