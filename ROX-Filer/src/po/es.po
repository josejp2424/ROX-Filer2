msgstr ""
"Izquierda: muestra/oculta archivos ocultos\n"
"Derecha: muestra/oculta miniaturas"

msgid ""
"Left: New Directory\n"
"Center: New Blank file\n"
"Right: Menu"
msgstr ""
"Izquierda: directorio nuevo\n"
"Centro: archivo vacío nuevo\n"
"Derecha: menú"

msgid "Show Rox-Filer2 help"
msgstr "Mostrar ayuda de «Rox-Filer2»"

msgid "Sort by name"
msgstr "Ordenar por nombre"

msgid "Sort by type"
msgstr "Ordenar por tipo"

msgid "Sort by date"
msgstr "Ordenar por fecha"

msgid "Sort by size"
msgstr "Ordenar por tamaño"

msgid "Sort by owner"
msgstr "Ordenar por propietario"

msgid "Sort by group"
msgstr "Ordenar por grupo"

