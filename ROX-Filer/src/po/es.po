msgstr "Iconos grandes"

#: tips:195 Options.xml.h:189
msgid "Same as the current window"
msgstr "Igual que la ventana actual"

#: tips:196 Options.xml.h:190
msgid "Same as the default view"
msgstr "Igual que la vista predeterminada"

#: tips:197 Options.xml.h:191
msgid "Open a terminal with the grave (`) key"
msgstr "Abrir una terminal con la tecla grave (`)"

#: tips:198 Options.xml.h:192
msgid "Classic panels"
msgstr "Paneles clásicos"

#: tips:199 Options.xml.h:193
msgid "Override window-manager control of classic panels"
msgstr "Ignorar el control del gestor de ventanas sobre los paneles clásicos"

#: tips:200 Options.xml.h:194
msgid "Treat classic panels as docks"
msgstr "Tratar los paneles clásicos como docks"

#: tips:201 Options.xml.h:195
msgid "Keep classic panels above other windows"
msgstr "Mantener los paneles clásicos sobre otras ventanas"

#: tips:202 Options.xml.h:196
msgid "Keep classic panels inside the work area"
msgstr "Mantener los paneles clásicos dentro del área de trabajo"

#: tips:203 Options.xml.h:197
msgid "Command-line compatibility"
msgstr "Compatibilidad con la línea de comandos"

#: tips:204 Options.xml.h:198
msgid "Create a rox command script"
msgstr "Crear un script de comando rox"

