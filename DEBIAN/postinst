#!/bin/sh
set -e
case "${1:-configure}" in
  configure|abort-upgrade|abort-remove|abort-deconfigure) ;;
  *) exit 0 ;;
esac

# 2.12.2-82: sin enlaces en /usr/local.  El lanzador es /usr/bin/roxfiler y
# rox, ROX-Filer y Rox-Filer2 son alias suyos, todos propiedad de dpkg.
command -v gtk-update-icon-cache >/dev/null 2>&1 && gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
exit 0
